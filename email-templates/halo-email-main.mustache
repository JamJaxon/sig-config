<table cellpadding="0" cellspacing="0" style="font-family:'Inter Tight',Arial,Helvetica,sans-serif;color:#1f1f1f;font-size: 14px;line-height:1.3;">
  <!-- load Google font -->
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap');
  </style>


  <tbody><tr>
    <!-- LEFT COLUMN -->
    <td valign="top" style="padding-right:12px;">
      <!-- Main logo -->
      <img src="https://framerusercontent.com/images/IRaeV045TXJNfYtzmrwgsP6CtsA.png?lossless=1&width=512&height=512" alt="Halo Logo" width="88" height="88" style="display:block;border-radius:16px;">
    </td>

    <!-- RIGHT COLUMN -->
    <td valign="top" style="padding-top:4px;">
      <table cellpadding="0" cellspacing="0" style="font-size:10px;">
        <tbody><tr>
          <td style="font-weight:700;font-size:12px;color:#181818;padding-bottom:2px;">
            {{your_name}}
          </td>
        </tr>
        <tr>
          <td style="color:#181818;padding-bottom:2px;">
            {{your_title}}
          </td>
        </tr>
        <tr>
          <td style="color:#969696;padding-bottom:2px;">
            <a href="mailto:{{your_email}}" style="color:#ed3e13;text-decoration:underline;">{{your_email}}</a>
          </td>
        </tr>
        <tr>
          <td style="color:#969696;padding-bottom:4;">
            <a href="https://halopowered.com" style="color:#ed3e13;text-decoration:underline;">halopowered.com</a>
          </td>
        </tr>

        <!-- Bottom row: Halo wordmark + social icons -->
        <tr>
          <td>
            <table cellpadding="0" cellspacing="0" style="padding-top:4px;">
              <tbody><tr>
                <!-- HALO logo -->
                

                <!-- LinkedIn -->
                <td style="padding-right:4px;">
                  <a href="https://www.linkedin.com/company/halo-media/" target="_blank">
                    <img src="https://framerusercontent.com/images/5jgx5VCgZ4x9T043AqGOYZHC5Uk.png?lossless=1&width=86&height=86" width="16" height="16" alt="LinkedIn" style="display:block;">
                  </a>
                </td>

                <!-- Facebook -->
                <td style="padding-right:4px;">
                  <a href="https://www.facebook.com/profile.php?id=61579230846660" target="_blank">
                    <img src="https://framerusercontent.com/images/K2Pob1dZOtY2NRgKfFMnNhr0Ow.png?lossless=1&width=84&height=83" width="16" height="16" alt="Facebook" style="display:block;">
                  </a>
                </td>

                <!-- Instagram -->
                <td>
                  <a href="https://www.instagram.com/halopowered" target="_blank">
                    <img src="https://framerusercontent.com/images/QroQJb0uMLSeUGbZl3JGmvCo28.png?lossless=1&width=86&height=86" width="16" height="16" alt="Instagram" style="display:block;">
                  </a>
                </td>
              </tr>
            </tbody></table>
          </td>
        </tr>
      </tbody></table>
    </td>
  </tr>
</tbody></table>